+void GameEnv::set_coach_defense_depth(int team_id, float value) {
+  SetGame(this);
+  GetTracker()->setDisabled(true);
+  if (team_id == 0 || team_id == 1) {
+    GetGameTask()->GetMatch()->GetTeam(team_id)->GetController()->SetCoachDefenseDepth(value);
+  }
+  GetTracker()->setDisabled(false);
+}
+
+float GameEnv::get_live_defense_depth(int team_id) {
+  SetGame(this);
+  GetTracker()->setDisabled(true);
+  float v = GetGameTask()->GetMatch()->GetTeam(team_id)->GetController()->GetLiveDefenseDepth();
+  GetTracker()->setDisabled(false);
+  return v;
+}
