+void TeamAIController::SetCoachDefenseDepth(float value) {
+  coachDefenseDepth = value < 0.0f ? -1.0f : clamp(value, 0.0f, 1.0f);
+  // apply immediately; UpdateTactics() re-applies it every 1000 ms of match time
+  if (coachDefenseDepth >= 0.0f) liveTeamTactics.Set("position_defense_depth_factor", coachDefenseDepth);
+  // clearing deliberately does NOT call UpdateTactics(): live values re-sync on the engine own 1000 ms schedule
